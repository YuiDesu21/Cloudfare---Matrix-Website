# Public browser configuration. The Supabase publishable key is safe to expose
# only when Row Level Security policies are enabled and tested.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only values. Never place these in browser JavaScript or commit them.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
